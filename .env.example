# Travel.ru — Переменные окружения
# Скопируйте в .env и заполните реальными значениями

APP_BASE_URL=http://127.0.0.1:8010

# Google OAuth (получить: https://console.cloud.google.com/apis/credentials)
# 1. Создайте проект в Google Cloud Console
# 2. Включите Google+ API
# 3. Создайте OAuth 2.0 Client ID (Web application)
# 4. В Authorized redirect URIs добавьте: http://127.0.0.1:8010/api/auth.php?action=google-callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
